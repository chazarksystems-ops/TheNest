{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerExitReceipt",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "worker_id",
    "final_score",
    "threshold",
    "reason",
    "fault_signature",
    "timestamp_unix_ms"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "hive.worker_exit_receipt.v0" },
    "run_id": { "type": "string", "minLength": 1 },
    "worker_id": { "type": "string", "minLength": 1 },
    "final_score": { "type": "number" },
    "threshold": { "type": "number" },
    "reason": {
      "type": "string",
      "enum": ["HealthThresholdBreached", "Timeout", "ValidationFailed", "Cancelled", "Completed"]
    },
    "fault_signature": { "type": "string" },
    "timestamp_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
